# Example configuration for the AI Event Planning Agent
# Copy this file to .env and enter your own Gemini API key.

GEMINI_API_KEY=
# Configurable alias; use a model available to your Gemini API account.
GEMINI_MODEL=gemini-flash-latest

# Optional live venue/catering-provider discovery; separate Google Maps Platform credential.
# Enable Places API (New) and billing. Environment values override the working-directory .env.
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY_HERE
